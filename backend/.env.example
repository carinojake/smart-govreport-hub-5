# ==============================================================================
# Smart GovReport Hub 2.5 - Environment Configuration Template
# Target: Docker PostgreSQL 16 (Port 5432) | Unified Production Core
# ==============================================================================

ENVIRONMENT=development
SMARTGOV_SECRET_KEY=replace_with_your_secure_secret_key

# PostgreSQL Docker Configuration (Port 5432)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=smartgov_v25

# Server & Network Configuration
PORT=8086
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085,http://localhost:8086,http://127.0.0.1:8086

# ==============================================================================
# Smart GovReport Hub 2.5 & OJT System - Environment Configuration Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามสภาพแวดล้อมจริง:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การตั้งค่าความปลอดภัยและระบบหลัก (Core & Security)
# ------------------------------------------------------------------------------
# คีย์สำหรับเข้ารหัส HMAC-SHA256 Token (แนะนำให้สุ่มรหัสผ่านยาว 64 ตัวอักษร เช่น openssl rand -hex 32)
SMARTGOV_SECRET_KEY=change_this_to_a_secure_random_64_char_hex_key_for_production

# โหมดการทำงานของระบบ (production / development)
# หากเป็น production ระบบจะซ่อน Docs / OpenAPI และเปิดมาตรการความปลอดภัยเข้มงวด
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. ปัญญาประดิษฐ์ (AI Integration - Gemini 1.5 Flash)
# ------------------------------------------------------------------------------
# ระบุ Google Gemini API Key เพื่อเปิดใช้งานระบบขัดเกลาภาษาราชการอัตโนมัติ (AI Gov Polish)
# หากไม่ระบุ ระบบจะใช้ Fallback Engine ขัดเกลาภาษาด้วย Template กฎระเบียบสารบรรณอัตโนมัติ
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. ฐานข้อมูลและบันทึกประวัติ (Database & Logging)
# ------------------------------------------------------------------------------
# ตำแหน่งไฟล์ SQLite Database (รองรับ WAL Mode)
SMARTGOV_DB_PATH=ojt_logbook.db

# ตำแหน่งไฟล์บันทึกประวัติการเข้าถึงข้อมูลส่วนบุคคลตาม พ.ร.บ. PDPA (JSONL Format)
SMARTGOV_AUDIT_LOG_PATH=logs/pdpa_audit.jsonl

# ------------------------------------------------------------------------------
# 4. เครือข่ายและเซิร์ฟเวอร์ (Server & Network)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=2
